# syntax=docker/dockerfile:1
# README demo image: real KDE Plasma 6.6 desktop (Ubuntu 26.04, X11) with the
# plugins built from this repository. Build from the repository root with
# demo/record.sh (or: docker build -f demo/Dockerfile.kde -t gpclient-demo-kde .).
# amd64 only (Microsoft Edge).

FROM ubuntu:26.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config dpkg-dev libglib2.0-dev libnm-dev \
        cmake extra-cmake-modules qt6-base-dev qt6-base-dev-tools \
        libkf6networkmanagerqt-dev libkf6i18n-dev libkf6service-dev \
        libkf6widgetsaddons-dev libkf6coreaddons-dev plasma-nm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY plugins/gnome plugins/gnome
COPY plugins/plasma plugins/plasma
COPY service service
COPY scripts scripts
COPY config config
COPY demo/install-plugin.sh demo/install-plugin.sh
RUN demo/install-plugin.sh kde /src /stage

FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg sudo iproute2 procps openssl libnss3-tools udev \
        network-manager python3 python3-sdbus libnma0 \
        dbus dbus-x11 xvfb xdotool ffmpeg x11-utils xauth libgl1-mesa-dri \
        fonts-noto-core fonts-noto-color-emoji \
        plasma-desktop plasma-workspace plasma-session-x11 kwin-x11 plasma-nm \
        systemsettings breeze breeze-icon-theme kde-config-gtk-style konsole \
        kubuntu-wallpapers dolphin \
    && rm -rf /var/lib/apt/lists/*

COPY demo/edge-policy.json demo/install-edge.sh /tmp/demo-edge/
RUN --mount=type=secret,id=extra_ca,required=false,mode=0444 \
    /tmp/demo-edge/install-edge.sh /tmp/demo-edge/edge-policy.json \
    && rm -rf /tmp/demo-edge /var/lib/apt/lists/*

# Desktop user (the base image has "ubuntu" with uid 1000)
RUN userdel -r ubuntu \
    && useradd -m -u 1000 -s /bin/bash -c "Alex Morgan" demo

COPY --from=builder /stage/ /
COPY demo/files/gpclient demo/files/gpauth /usr/bin/
COPY demo/files/loginctl /usr/local/bin/loginctl
COPY demo/files/sso-server.py demo/files/make-certs.sh /opt/gp-demo/
COPY demo/files/www /opt/gp-demo/www
COPY demo/lib.sh /opt/gp-demo/lib.sh
COPY demo/session /opt/gp-demo/session
COPY demo/scenario-kde.sh /opt/gp-demo/scenario.sh
COPY demo/99-demo.conf /etc/NetworkManager/conf.d/99-demo.conf

# Fictional CA and server certificate; the CA goes into the system store and
# into the NSS database of the desktop user (Edge reads it)
RUN /opt/gp-demo/make-certs.sh /opt/gp-demo/certs \
    && cp /opt/gp-demo/certs/ca.crt /usr/local/share/ca-certificates/contoso-demo-ca.crt \
    && update-ca-certificates \
    && install -d -o demo -g demo -m 700 /home/demo/.pki/nssdb \
    && runuser -u demo -- certutil -N -d sql:/home/demo/.pki/nssdb --empty-password \
    && runuser -u demo -- certutil -A -d sql:/home/demo/.pki/nssdb -n "Contoso Demo Root CA" -t "C,," -i /opt/gp-demo/certs/ca.crt \
    && chmod +x /opt/gp-demo/*.sh /opt/gp-demo/session/*.sh /usr/bin/gpclient /usr/bin/gpauth /usr/local/bin/loginctl

ENTRYPOINT ["/opt/gp-demo/session/start.sh", "kde"]
