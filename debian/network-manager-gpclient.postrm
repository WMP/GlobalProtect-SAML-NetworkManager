#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Kill VPN service process if still running
        # Match the command line of the Python interpreter that runs the service
        # (new path or old name), anchored: see the postinst.
        service_re='^(/usr/bin/)?python3(\.[0-9]+)* (/usr/lib/NetworkManager/nm-gpclient-service|/usr/libexec/NetworkManager/gpclient-nm-service)( |$)'
        if pgrep -f "$service_re" >/dev/null 2>&1; then
            echo "Stopping nm-gpclient-service..."
            pkill -f "$service_re" || true
        fi

        # Reload D-Bus configuration
        if [ -x /usr/bin/dbus-send ]; then
            dbus-send --system --type=method_call --dest=org.freedesktop.DBus \
                /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
