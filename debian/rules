#!/usr/bin/make -f

export DH_VERBOSE = 1

# Defines DEB_HOST_MULTIARCH (x86_64-linux-gnu, aarch64-linux-gnu, ...) of the target
include /usr/share/dpkg/architecture.mk

# The Qt of the Plasma plugin is the one debian/control (a copy of
# debian/control.ubuntu<version>) lists in Build-Depends: qtbase5-dev for Qt5,
# qt6-base-dev for Qt6. Empty when it lists both or none; the build stops then.
# ${call qt_listed,<package>} is "yes" when the Build-Depends field (from its
# line to the next field) lists the package as a whole name: followed by a
# version "(>= 5.15)", an architecture ":native", a comma, "|" or the end of the
# line; on the line of the field or below it, also as the last entry.
qt_listed = ${shell awk -v pkg=${1} ' \
	/^\#/ { next } \
	/^[ \t]*$$/ { infield = 0; next } \
	/^[^ \t]/ { infield = (tolower($$0) ~ /^build-depends:/); sub(/^[^:]*:/, "") } \
	infield && (" " $$0) ~ ("[ \t,|]" pkg "([ \t(:,|]|$$)") { print "yes"; exit }' debian/control}
HAS_QT5 := ${call qt_listed,qtbase5-dev}
HAS_QT6 := ${call qt_listed,qt6-base-dev}
PLASMA_QT_MAJOR := $(if $(HAS_QT5),$(if $(HAS_QT6),,5),$(if $(HAS_QT6),6,))

# The packages debian/control builds. debian/control.ubuntu24.04-neon (KDE neon:
# Ubuntu 24.04 with Plasma 6) has the Plasma package network-manager-gpclient-plasma-6
# only, no core package: such a build makes just the Plasma plugin (no GNOME
# plugins, no Rust, nothing of the core install; HAS_CORE is empty). Every other
# control file has the core package and network-manager-gpclient-plasma.
# PLASMA_PACKAGE is the one Plasma package, empty when there are none or several.
CONTROL_PACKAGES := ${shell awk 'tolower($$0) ~ /^package:/ { print $$2 }' debian/control}
PLASMA_PACKAGES := $(filter network-manager-gpclient-plasma network-manager-gpclient-plasma-6,${CONTROL_PACKAGES})
PLASMA_PACKAGE := $(if $(filter 1,$(words ${PLASMA_PACKAGES})),${PLASMA_PACKAGES},)
HAS_CORE := $(filter network-manager-gpclient,${CONTROL_PACKAGES})

%:
	dh $@

override_dh_auto_build:
ifneq ($(HAS_CORE),)
	# Ensure GlobalProtect-openconnect nested submodules (openconnect + libxml2)
	# are checked out. The openconnect crate build.rs needs their C sources to
	# build and patch the static library; without a recursive checkout the
	# cargo build below fails. In a git checkout the target syncs and updates
	# the nested submodules to the pinned commits (a no-op when they are right);
	# it does nothing when the sources were copied into the build container
	# (no usable git there) and are already present.
	$(MAKE) init-submodules

	# Build GNOME plugins only (Rust binaries are built separately below)
	$(MAKE) gnome-plugins
endif

	# Build the Plasma plugin against the Qt that debian/control builds with
	@test -n "$(PLASMA_QT_MAJOR)" || { \
		echo "debian/control must have exactly one of qtbase5-dev and qt6-base-dev in Build-Depends"; exit 1; }
	@test -n "$(PLASMA_PACKAGE)" || { \
		echo "debian/control must have exactly one of network-manager-gpclient-plasma and network-manager-gpclient-plasma-6"; exit 1; }
	mkdir -p plugins/plasma/build
	cd plugins/plasma/build && cmake .. -DQT_MAJOR_VERSION=$(PLASMA_QT_MAJOR) && $(MAKE)

ifneq ($(HAS_CORE),)
	# Build Rust binaries (gpclient and gpauth)
	# Cargo will reuse compiled dependencies from target cache volume
	# Only local crates (gpauth, gpclient, gpapi, common, openconnect) will be recompiled
	@echo "Building gpclient and gpauth (reusing cached dependencies)..."
	cd external/GlobalProtect-openconnect && cargo build --release --bin gpclient --bin gpauth
endif

override_dh_auto_install:
	@test -n "$(PLASMA_PACKAGE)" || { \
		echo "debian/control must have exactly one of network-manager-gpclient-plasma and network-manager-gpclient-plasma-6"; exit 1; }
ifneq ($(HAS_CORE),)
	# Install backend plugin (base package - needed for nmcli)
	install -D -m 644 libnm-vpn-plugin-gpclient.so \
		$(CURDIR)/debian/network-manager-gpclient/usr/lib/$(DEB_HOST_MULTIARCH)/NetworkManager/libnm-vpn-plugin-gpclient.so

	# Install GNOME GUI plugins (editor libraries)
	install -D -m 644 libnm-vpn-plugin-gpclient-editor.so \
		$(CURDIR)/debian/network-manager-gpclient-gnome/usr/lib/$(DEB_HOST_MULTIARCH)/NetworkManager/libnm-vpn-plugin-gpclient-editor.so
	# Install GTK4 plugin only if it was built (available on Ubuntu 24.04+)
	if [ -f libnm-gtk4-vpn-plugin-gpclient-editor.so ]; then \
		install -D -m 644 libnm-gtk4-vpn-plugin-gpclient-editor.so \
			$(CURDIR)/debian/network-manager-gpclient-gnome/usr/lib/$(DEB_HOST_MULTIARCH)/NetworkManager/libnm-gtk4-vpn-plugin-gpclient-editor.so; \
	fi

	# Create symlink for libnm-gpclient-properties (GNOME)
	mkdir -p $(CURDIR)/debian/network-manager-gpclient-gnome/usr/lib
	ln -sf /usr/lib/$(DEB_HOST_MULTIARCH)/NetworkManager/libnm-vpn-plugin-gpclient-editor.so \
		$(CURDIR)/debian/network-manager-gpclient-gnome/usr/lib/libnm-gpclient-properties

	# Install auth dialog (interactive credentials/RSA token prompts, GTK)
	install -D -m 755 auth-dialog/nm-gpclient-auth-dialog.py \
		$(CURDIR)/debian/network-manager-gpclient-gnome/usr/libexec/nm-gpclient-auth-dialog
endif

	# Install Plasma plugin (into network-manager-gpclient-plasma, or into
	# network-manager-gpclient-plasma-6 of the KDE neon variant)
	# Plugin install path depends on the Qt major version we built against:
	#   Qt5 (Ubuntu 22.04/24.04): /usr/lib/<multiarch>/qt5/plugins/...
	#   Qt6 (Ubuntu 24.10/26.04, KDE neon on 24.04): /usr/lib/<multiarch>/qt6/plugins/...
	install -D -m 644 plugins/plasma/build/plasmanetworkmanagement_gpclientui.so \
		$(CURDIR)/debian/$(PLASMA_PACKAGE)/usr/lib/$(DEB_HOST_MULTIARCH)/qt$(PLASMA_QT_MAJOR)/plugins/plasma/network/vpn/plasmanetworkmanagement_gpclientui.so
	install -D -m 644 plugins/plasma/plasmanetworkmanagement_gpclientui.json \
		$(CURDIR)/debian/$(PLASMA_PACKAGE)/usr/lib/$(DEB_HOST_MULTIARCH)/qt$(PLASMA_QT_MAJOR)/plugins/plasma/network/vpn/plasmanetworkmanagement_gpclientui.json
	# KF5 used a .desktop service file (/usr/share/kservices5); KF6 dropped that
	# mechanism and reads only the embedded JSON metadata, so we skip the file there.
	@if [ "$(PLASMA_QT_MAJOR)" = 5 ]; then \
		install -D -m 644 plugins/plasma/plasmanetworkmanagement_gpclientui.desktop \
			$(CURDIR)/debian/$(PLASMA_PACKAGE)/usr/share/kservices5/plasmanetworkmanagement_gpclientui.desktop; \
	fi

ifneq ($(HAS_CORE),)
	# Install core service files (base package)
	install -D -m 644 plugins/gnome/nm-gpclient-service.name \
		$(CURDIR)/debian/network-manager-gpclient/usr/lib/NetworkManager/VPN/nm-gpclient-service.name
	install -D -m 755 service/nm-gpclient-service.py \
		$(CURDIR)/debian/network-manager-gpclient/usr/lib/NetworkManager/nm-gpclient-service
	install -D -m 755 scripts/browser-wrapper.sh \
		$(CURDIR)/debian/network-manager-gpclient/usr/libexec/gpclient/browser-wrapper
	install -D -m 755 scripts/edge-wrapper.sh \
		$(CURDIR)/debian/network-manager-gpclient/usr/libexec/gpclient/edge-wrapper

	# Install systemd service file
	install -D -m 644 config/nm-gpclient.service \
		$(CURDIR)/debian/network-manager-gpclient/lib/systemd/system/nm-gpclient.service

	# Install D-Bus service file for automatic activation
	install -D -m 644 config/org.freedesktop.NetworkManager.gpclient.service \
		$(CURDIR)/debian/network-manager-gpclient/usr/share/dbus-1/system-services/org.freedesktop.NetworkManager.gpclient.service

	# Install D-Bus policy file
	install -D -m 644 config/nm-gpclient.conf \
		$(CURDIR)/debian/network-manager-gpclient/etc/dbus-1/system.d/nm-gpclient.conf

	# Create compatibility symlink for old path
	mkdir -p $(CURDIR)/debian/network-manager-gpclient/usr/libexec/NetworkManager
	ln -sf /usr/lib/NetworkManager/nm-gpclient-service \
		$(CURDIR)/debian/network-manager-gpclient/usr/libexec/NetworkManager/gpclient-nm-service

	# Install Rust binaries (gpclient and gpauth)
	install -D -m 755 external/GlobalProtect-openconnect/target/release/gpclient \
		$(CURDIR)/debian/network-manager-gpclient/usr/bin/gpclient
	install -D -m 755 external/GlobalProtect-openconnect/target/release/gpauth \
		$(CURDIR)/debian/network-manager-gpclient/usr/bin/gpauth

	# Install .desktop file for URL handler registration (globalprotectcallback://)
	install -D -m 644 external/GlobalProtect-openconnect/packaging/files/usr/share/applications/gpgui.desktop \
		$(CURDIR)/debian/network-manager-gpclient/usr/share/applications/gpgui.desktop

	# Install vpnc hook for routing configuration
	install -D -m 755 config/90-gpclient-routing \
		$(CURDIR)/debian/network-manager-gpclient/etc/vpnc/connect.d/90-gpclient-routing
endif


override_dh_auto_clean:
	$(MAKE) clean || true
	rm -rf plugins/plasma/build debs

override_dh_gencontrol:
	@echo ======================================================= override_dh_gencontrol:
	dh_gencontrol
	find debian/ -type f -name "control" -exec sed -i 's/\(lib[a-zA-Z0-9.+-]\+\)t64/\0 | \1/g' {} +

