   </rect>
  </property>
  <property name="windowTitle">
   <string>GlobalProtect VPN</string>
  </property>
  <layout class="QFormLayout" name="formLayout">
   <property name="fieldGrowthPolicy">
    <enum>QFormLayout::ExpandingFieldsGrow</enum>
